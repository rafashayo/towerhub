PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Dev-only defaults — generate real random secrets for production
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_PEPPER=dev-refresh-pepper-change-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# "Remember me" unchecked at login: session-only cookie, capped at this many hours server-side.
SESSION_ONLY_TTL_HOURS=12

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MIN=15

# Optional. Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# Leave empty to no-op (the server logs a note instead of posting). Note: the
# embed's image/link URLs are built from CLIENT_ORIGIN above, which Discord's
# servers must be able to reach — that means images won't render while
# CLIENT_ORIGIN is http://localhost:5173, only once this is deployed behind a
# real public domain.
DISCORD_WEBHOOK_URL=
